#!/bin/sh
# Tell the owner that something on the registry needs them. Run by yard-job when a scheduled job fails, or by hand:
#   echo "details" | yard-alert "subject"
# Where it goes is set in .env: YARD_ALERT_WEBHOOK, YARD_ALERT_SMTP_*, or both.
set -eu
what=${1:?usage: yard-alert SUBJECT}
host=${YARD_DOMAIN:-$(hostname)}
subject="[yard] $what failed on $host"
body=""
[ -t 0 ] || body=$(cat)
[ -n "$body" ] || body="(no details)"
text="$subject

$body

Runbook: docs/registry.md, \"Runbook\". Status: docker compose exec yard yard status /srv/yard/yard.json"
sent=0

if [ -n "${YARD_ALERT_WEBHOOK:-}" ]; then
	json=$(jq -n --arg t "$text" '{text: $t, content: $t[:1900]}')
	if curl -fsS --max-time 20 -H 'content-type: application/json' --data "$json" "$YARD_ALERT_WEBHOOK" >/dev/null; then
		sent=1
	else
		echo "yard-alert: the webhook did not take it" >&2
	fi
fi

if [ -n "${YARD_ALERT_SMTP_URL:-}" ] && [ -n "${YARD_ALERT_TO:-}" ]; then
	mail=$(mktemp)
	trap 'rm -f "$mail"' EXIT
	{
		printf 'From: %s\r\nTo: %s\r\nSubject: %s\r\nDate: %s\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n' \
			"${YARD_ALERT_FROM:-$YARD_ALERT_TO}" "$YARD_ALERT_TO" "$subject" "$(date -R)"
		printf '%s\n' "$text"
	} > "$mail"
	if curl -fsS --max-time 30 --ssl-reqd --url "$YARD_ALERT_SMTP_URL" \
		--user "${YARD_ALERT_SMTP_USER:-}:${YARD_ALERT_SMTP_PASSWORD:-}" \
		--mail-from "${YARD_ALERT_FROM:-$YARD_ALERT_TO}" --mail-rcpt "$YARD_ALERT_TO" --upload-file "$mail"; then
		sent=1
	else
		echo "yard-alert: the mail server did not take it" >&2
	fi
fi

if [ "$sent" = 0 ]; then
	echo "yard-alert: no alert was sent (set YARD_ALERT_WEBHOOK or YARD_ALERT_SMTP_* in .env): $subject" >&2
	exit 1
fi
