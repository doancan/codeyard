#!/bin/sh
# The hourly check (yard-scheduler): the service answers, the index does not expire within 24 h, the online key not
# within 14 days, the database is being copied to R2, /metrics is refused to a proxied request, and the site answers.
# A failure is alerted by yard-job; the GitHub workflow yard-monitor checks the same from outside, through the proxy.
set -u
problems=0
fail() {
	echo "yard-watch: $*" >&2
	problems=$((problems + 1))
}
curl -fsS --max-time 10 http://yard:8080/healthz >/dev/null || fail "yard does not answer (docker compose logs yard)"
if ! out=$(yard status /srv/yard/yard.json --hours 24 --key-days 14 2>&1); then
	fail "$out"
else
	echo "$out"
fi
curl -fsS --max-time 10 http://litestream:9090/metrics >/dev/null || fail "litestream does not answer: the database is not being copied to R2"
code=$(curl -s --max-time 10 -o /dev/null -w '%{http_code}' -H 'X-Forwarded-For: 192.0.2.1' http://yard:8080/metrics)
[ "$code" = 404 ] || fail "yard answers a proxied /metrics with $code, not 404: monitoring data would leave through the proxy"
curl -fsS --max-time 10 http://yard:8080/ | grep -q '<title>Codeyard' || fail "the site does not answer at / (is \"site\" set in /srv/yard/yard.json?)"
[ "$problems" = 0 ]
