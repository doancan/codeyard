# .env, beside compose.yml (mode 600, owned by root): every secret the stack needs, and nothing else. setup-host.sh
# installs this template on the first run; fill it in, then `docker compose up -d`. Never commit the filled-in file.

# The registry's address. Nginx Proxy Manager has one proxy host with both names, yardcode.app (the site) and
# market.yardcode.app (the registry, which the app and cyx use), forwarding to http://codeyard-yard:8080 with an
# SSL certificate (Let's Encrypt), "Force SSL" and "HTTP/2" on.
YARD_DOMAIN=market.yardcode.app
# dev: when the registry's folder is empty, yard creates the registry itself with a root key kept on the server, for a
# trial or a start before the root key ceremony. Leave it out for the public registry (created with the ceremony's keys).
#YARD_AUTO_INIT=dev

# The image the yard-image workflow publishes (yard and the site inside). `docker compose pull` fetches a new one.
# Leave it out to build the image here from this folder, with yard from ./bin.
YARD_IMAGE=ghcr.io/doancan/codeyard-yard:latest

# How the proxy reaches yard: compose.npm.yml joins Nginx Proxy Manager's Docker network (NPM_NETWORK, its name in
# `docker network ls`); compose.port.yml instead publishes YARD_PORT on the host, for a proxy outside Docker.
COMPOSE_FILE=compose.yml:compose.npm.yml
NPM_NETWORK=
#COMPOSE_FILE=compose.yml:compose.port.yml
#YARD_PORT=127.0.0.1:8080

# Where the registry's folder lives: a folder on the server (setup-host.sh makes it), or leave it out for a Docker
# volume (the test does).
YARD_DATA=/srv/yard

# Backups: a Cloudflare R2 bucket and an API token for that bucket only
# (R2 → Manage API tokens → Create → "Object Read & Write", applied to this bucket).
YARD_R2_BUCKET=codeyard-yard-backup
YARD_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
YARD_R2_ACCESS_KEY_ID=
YARD_R2_SECRET_ACCESS_KEY=

# Alerts (yard-alert): a webhook, an SMTP account, or both. A webhook gets a JSON POST with "text" (Slack,
# Mattermost, Google Chat) and "content" (Discord); ntfy.sh topics take it too.
YARD_ALERT_WEBHOOK=
# SMTP over TLS, e.g. smtps://smtp.fastmail.com:465 or smtp://smtp.example.com:587 (STARTTLS is required).
YARD_ALERT_SMTP_URL=
YARD_ALERT_SMTP_USER=
YARD_ALERT_SMTP_PASSWORD=
YARD_ALERT_FROM=
YARD_ALERT_TO=
