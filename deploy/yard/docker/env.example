# .env, beside compose.yml (mode 600, owned by root): every secret the stack needs, and nothing else. setup-host.sh
# installs this template on the first run; fill it in, then `docker compose up -d`. Never commit the filled-in file.

# The registry's address (the tunnel's public hostname in Cloudflare).
YARD_DOMAIN=market.yardcode.app

# Where the registry's folder lives: a folder on the server (setup-host.sh makes it), or leave it out for a Docker
# volume (the test does).
YARD_DATA=/srv/yard

# The tunnel: Cloudflare Zero Trust → Networks → Tunnels → the tunnel → its token. The tunnel's public hostname
# market.yardcode.app points at http://edge:8000. Leave COMPOSE_PROFILES out and no tunnel runs.
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Backups: a Cloudflare R2 bucket and an API token for that bucket only
# (R2 → Manage API tokens → Create → "Object Read & Write", applied to this bucket).
YARD_R2_BUCKET=codeyard-yard-backup
YARD_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
YARD_R2_ACCESS_KEY_ID=
YARD_R2_SECRET_ACCESS_KEY=

# Alerts (yard-alert): a webhook, an SMTP account, or both. A webhook gets a JSON POST with "text" (Slack,
# Mattermost, Google Chat) and "content" (Discord); ntfy.sh topics take it too.
YARD_ALERT_WEBHOOK=
# SMTP over TLS, e.g. smtps://smtp.fastmail.com:465 or smtp://smtp.example.com:587 (STARTTLS is required).
YARD_ALERT_SMTP_URL=
YARD_ALERT_SMTP_USER=
YARD_ALERT_SMTP_PASSWORD=
YARD_ALERT_FROM=
YARD_ALERT_TO=
