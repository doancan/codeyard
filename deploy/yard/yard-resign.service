# A fresh signature on the index every day, beside the one `yard serve` makes: the index (72 h) never expires while
# either runs. A failure alerts the owner.
[Unit]
Description=Sign the extension registry's index again
OnFailure=yard-alert@%n.service

[Service]
Type=oneshot
User=yard
Group=yard
ExecStart=/usr/local/bin/yard resign /srv/yard/yard.json
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/yard
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0027
