#!/bin/sh
# The server's firewall (ufw): SSH from anywhere (rate-limited), HTTPS from Cloudflare's addresses only, nothing else.
# Run by setup.sh and monthly by yard-firewall.timer, since Cloudflare's address list can change.
set -eu
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
curl -fsS --max-time 20 https://www.cloudflare.com/ips-v4 > "$tmp"
echo >> "$tmp"
curl -fsS --max-time 20 https://www.cloudflare.com/ips-v6 >> "$tmp"
ranges=$(grep -E '^[0-9a-f:.]+/[0-9]+$' "$tmp" || true)
[ "$(printf '%s\n' "$ranges" | grep -c .)" -ge 10 ] || { echo "Cloudflare's address list looks wrong; nothing changed" >&2; exit 1; }
ufw default deny incoming
ufw default allow outgoing
ufw limit OpenSSH
# Replace the Cloudflare rules: delete the old ones from the highest number down, then add the current list.
ufw status numbered | sed -n 's/^\[ *\([0-9][0-9]*\)\].*# cloudflare$/\1/p' | sort -rn | while read -r n; do
	ufw --force delete "$n" >/dev/null
done
for r in $ranges; do
	ufw allow proto tcp from "$r" to any port 443 comment cloudflare >/dev/null
done
ufw --force enable
echo "yard-firewall: HTTPS from $(printf '%s\n' "$ranges" | grep -c .) Cloudflare ranges, SSH from anywhere"
