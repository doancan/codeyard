# Daily copy of everything but the database (packages, signatures, root.json, yard.json) to object storage. The
# online key is not copied: after a restore the root key holders sign a new one (docs/registry.md, Restore).
[Unit]
Description=Copy the extension registry's files to the backup bucket

[Service]
Type=oneshot
EnvironmentFile=/etc/yard/backup.env
ExecStart=/usr/bin/rclone sync /srv/yard yardbackup:${YARD_BACKUP_BUCKET}/files --exclude "keys/**" --exclude "yard.sqlite*" --exclude "*.tmp*"
