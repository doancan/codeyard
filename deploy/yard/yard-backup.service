# Daily copy to R2 (deploy/yard/backup): files and a database snapshot, beside Litestream's continuous copy. The
# online key is not copied: after a restore the root key holders sign a new one (docs/registry.md, Restore).
[Unit]
Description=Copy the extension registry to the backup bucket
OnFailure=yard-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/yard-backup
