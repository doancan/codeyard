# /etc/yard/backup.env (mode 600, owned by root). A Cloudflare R2 bucket and an API token for it only:
# R2 → Manage API tokens → "Object Read & Write" for this bucket.
YARD_BACKUP_BUCKET=codeyard-yard-backup
YARD_BACKUP_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
# rclone reads the same keys through its environment configuration.
RCLONE_CONFIG_YARDBACKUP_TYPE=s3
RCLONE_CONFIG_YARDBACKUP_PROVIDER=Cloudflare
RCLONE_CONFIG_YARDBACKUP_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
RCLONE_CONFIG_YARDBACKUP_ACCESS_KEY_ID=
RCLONE_CONFIG_YARDBACKUP_SECRET_ACCESS_KEY=
