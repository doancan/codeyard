# Signed test fixtures: their bytes are what was signed, so no line-ending conversion on checkout.
crates/ext-core/testdata/** -text
# Unix shell startup files are also embedded by Windows cross builds.
crates/agent/src/shell/** text eol=lf
# Compiled WebAssembly test fixtures.
*.wasm binary
# Captured tool output (rust-analyzer, nextest, rustc, crates.io): tests compare exact text, so no CRLF conversion on Windows checkouts.
crates/app/testdata/** text eol=lf
