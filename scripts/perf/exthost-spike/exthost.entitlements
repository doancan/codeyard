<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The exthost's only hardened-runtime exception (#97, README.md). `allow-jit` is not enough: wasmtime makes
     anonymous memory executable with mprotect, not MAP_JIT. The app binary gets no such exception. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
