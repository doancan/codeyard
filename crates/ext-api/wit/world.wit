package codeyard:api@0.1.0;

/// What the host asks the extension.
@since(version = 0.1.0)
interface host-requests {
  use types.{document, range, diagnostic, uri, position};
  use responses.{code-lens};

  record format-options {
    tab-size: u32,
    insert-spaces: bool,
  }

  variant request {
    /// A command from the manifest: its local id and JSON arguments.
    command(tuple<string, string>),
    /// Draw a view (by local id); answer with `response.view`.
    render(string),
    /// Something happened in a view: its local id and the event as JSON, such as `{"click": {"path": ["refresh"]}}` (reference/ui.md).
    ui-event(tuple<string, string>),
    /// Format a document, or a range of it; answer with `response.edits`.
    format(tuple<document, option<range>, format-options>),
    /// Offer code actions for a range; answer with `response.code-actions`.
    code-actions(tuple<document, range, list<diagnostic>>),
    /// The user chose a code action that has a command.
    run-code-action(string),
    /// List tasks; answer with `response.tasks`.
    provide-tasks,
    /// Run a task the extension provided, by id.
    run-task(string),
    /// These settings of the extension changed.
    settings-changed(list<string>),
    /// A timer from `timers.every` fired.
    timer(u64),
    /// The user cancelled progress started with `window.start-progress`.
    cancel-progress(u64),
    /// A `codeyard://ext/<id>/…` link was opened: its path and query.
    open-uri(string),
    /// Describe what is at a position (the mouse rests there, or Show Hover); answer with `response.hover`.
    hover(tuple<document, position>),
    /// Offer completions at a position; answer with `response.completions`. The string is the character that was
    /// typed when it is one of the manifest's `trigger-characters`, none when the user typed a word or asked.
    completion(tuple<document, position, option<string>>),
    /// Code lenses for the lines of a document in view: the range starts at the first and ends at the start of the line
    /// after the last. Answer with `response.code-lenses`.
    code-lens(tuple<document, range>),
    /// A lens answered without a command is on screen: answer with `response.code-lenses` holding it with its command.
    resolve-code-lens(tuple<document, code-lens>),
    /// Inlay hints for the lines of a document in view (the range, as for `code-lens`); answer with `response.inlay-hints`.
    inlay-hints(tuple<document, range>),
    /// The source control state of a folder a `[[scm]]` provider claims: the provider's local id and the folder;
    /// answer with `response.scm`.
    scm-status(tuple<string, uri>),
    /// The text of a file as the provider last recorded it, for the gutter's change marks: the provider's local id
    /// and the file; answer with `response.text`, none for a file the provider does not track.
    scm-original(tuple<string, uri>),
    /// Check the input box's text: the provider's local id, the folder and the text; answer with `response.text`, a
    /// message shown under the box (none when the text is fine).
    scm-validate(tuple<string, uri, string>),
  }
}

/// What the extension exports. The SDKs implement it; authors never see it.
@since(version = 0.1.0)
interface guest {
  use types.{ticket, completion, stream-event};
  use host-requests.{request};

  record activation {
    /// Why the extension started: `command:<id>`, `view:<id>`, `language:<id>`, `workspace-contains`, `uri`, `auth`,
    /// `scm:<id>`.
    reason: string,
  }

  /// Called once, before anything else.
  activate: func(activation: activation) -> result<_, string>;
  /// Called before the exthost stops. Keep it short: the process exits after a deadline.
  deactivate: func();
  /// A request; answer it now or later with `requests.respond(id, …)`. Must return quickly.
  handle: func(id: u64, request: request);
  /// The host no longer waits for request `id` (the user moved on).
  cancel: func(id: u64);
  /// A ticket finished.
  complete: func(ticket: ticket, %result: completion);
  /// Streamed data for a ticket that has not finished.
  event: func(ticket: ticket, event: stream-event);
}

/// Everything an extension may import. Each interface outside `types`, `log`, `env`, `tickets`, `requests`,
/// `responses`, `window`, `commands`, `storage`, `settings`, `timers`, `ui`, `documents`, `languages`, `scm` and
/// `host-requests` needs its permission in the manifest.
world extension {
  import log;
  import env;
  import tickets;
  import requests;
  import window;
  import commands;
  import storage;
  import settings;
  import timers;
  import ui;
  import documents;
  import languages;
  import workspace;
  import workspace-write;
  import net;
  import auth;
  import secrets;
  import process;
  import clipboard-read;
  import clipboard-write;
  import terminal;
  import scm;

  export guest;
}
