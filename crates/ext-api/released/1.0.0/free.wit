package codeyard:api@1.0.0;

/// Messages for the extension's log, shown in the Inspector.
@since(version = 1.0.0)
interface log {
  @since(version = 1.0.0)
  enum level {
    trace,
    debug,
    info,
    warn,
    error,
  }

  @since(version = 1.0.0)
  log: func(level: level, message: string);
}

/// What the extension runs in. Known at activation, so these calls are cheap.
@since(version = 1.0.0)
interface env {
  @since(version = 1.0.0)
  enum theme-kind {
    light,
    dark,
    high-contrast-light,
    high-contrast-dark,
  }

  @since(version = 1.0.0)
  enum platform {
    macos,
    linux,
    windows,
  }

  @since(version = 1.0.0)
  record environment {
    codeyard-version: string,
    api-version: string,
    /// The interface language, such as `en` or `tr`.
    language: string,
    theme: theme-kind,
    platform: platform,
    /// The workspace is on an SSH host.
    remote: bool,
    workspace-trusted: bool,
  }

  @since(version = 1.0.0)
  info: func() -> environment;
}

/// Calls the host has not answered yet.
@since(version = 1.0.0)
interface tickets {
  use types.{ticket};

  /// Stop waiting: the ticket completes with `cancelled`, and a running process is killed.
  @since(version = 1.0.0)
  cancel: func(ticket: ticket);
}

/// Answers to `guest.handle`.
@since(version = 1.0.0)
interface requests {
  use types.{error};
  use responses.{response};

  /// Answer request `id`. A request is answered once; late answers (after `guest.cancel`) are dropped.
  @since(version = 1.0.0)
  respond: func(id: u64, %result: result<response, error>);
}

/// What `guest.handle` answers with.
@since(version = 1.0.0)
interface responses {
  use types.{text-edit, diagnostic, range, position, uri};
  use scm.{scm-state};
  use pull-requests.{answer};

  @since(version = 1.0.0)
  record code-action {
    /// Passed back in `request.run-code-action`.
    id: string,
    title: string,
    /// Edits applied when chosen; a command runs instead when empty and `command` is set.
    edits: list<tuple<uri, list<text-edit>>>,
    command: option<string>,
    preferred: bool,
    /// The diagnostics this action fixes.
    fixes: list<diagnostic>,
  }

  @since(version = 1.0.0)
  record task {
    /// Passed back in `request.run-task`.
    id: string,
    label: string,
    detail: option<string>,
    /// `build`, `test`, or empty.
    group: string,
  }

  /// What a code lens shows and the command a click runs.
  @since(version = 1.0.0)
  record lens-command {
    title: string,
    /// The extension's own command (local or full id), a dependency's full id, or a `core:` command the manifest
    /// lists in `permissions.commands`.
    command: string,
    /// The command's arguments as JSON; `null` for none.
    args-json: string,
  }

  @since(version = 1.0.0)
  record code-lens {
    /// Passed back in `request.resolve-code-lens`.
    id: string,
    /// The lens shows above the range's first line.
    range: range,
    /// None until resolved: the host sends `request.resolve-code-lens` once the lens is on screen.
    command: option<lens-command>,
  }

  @since(version = 1.0.0)
  record inlay-hint {
    /// Where the hint belongs; it shows at the end of its line.
    position: position,
    label: string,
    tooltip: option<string>,
  }

  @since(version = 1.0.0)
  variant response {
    /// Nothing to return (a command that finished, an event handled).
    none,
    /// A command's result.
    json(string),
    /// A view: its element tree as JSON, nested `{key, element, children}` nodes (reference/ui.md). The host checks it.
    view(string),
    edits(list<text-edit>),
    code-actions(list<code-action>),
    tasks(list<task>),
    /// The ranges a task's problem matcher should look at, or a formatter's changed ranges.
    ranges(list<range>),
    /// What `request.hover` describes, or none.
    hover(option<hover>),
    /// The answer to `request.completion`.
    completions(completion-list),
    code-lenses(list<code-lens>),
    inlay-hints(list<inlay-hint>),
    /// A folder's source control state (`request.scm-status`).
    scm(scm-state),
    /// Some text, or none: a file's original text (`request.scm-original`), a validation message (`request.scm-validate`).
    text(option<string>),
    /// The answer to `request.pull-requests`.
    pull-requests(answer),
  }

  /// Shown in the hover popup next to the language server's, under the extension's name.
  @since(version = 1.0.0)
  record hover {
    /// Markdown; Codeyard shows it as plain text.
    contents: string,
    /// The range described; the word at the position when none.
    range: option<range>,
  }

  /// The icon a completion item shows, as in the Language Server Protocol.
  @since(version = 1.0.0)
  enum completion-kind {
    text,
    method,
    function,
    %constructor,
    field,
    variable,
    class,
    %interface,
    module,
    property,
    unit,
    value,
    %enum,
    keyword,
    snippet,
    color,
    file,
    reference,
    folder,
    enum-member,
    constant,
    struct,
    event,
    operator,
    type-parameter,
  }

  @since(version = 1.0.0)
  record completion-item {
    /// Shown in the list, and inserted when `insert-text` is none.
    label: string,
    kind: completion-kind,
    /// One line shown next to the label, such as a type.
    detail: option<string>,
    /// Markdown shown beside the list while the item is selected.
    documentation: option<string>,
    insert-text: option<string>,
    /// `insert-text` is a snippet: `$1`, `${1:default}` and `$0` are tab stops.
    snippet: bool,
    /// The text replaced; the word before the cursor when none. On the line of the position.
    range: option<range>,
    /// More edits made when the item is chosen, such as an import; they may not overlap `range`.
    additional-edits: list<text-edit>,
    /// Matched against what the user typed; the label when none.
    filter-text: option<string>,
    /// Orders items that match equally well; the label when none.
    sort-text: option<string>,
  }

  @since(version = 1.0.0)
  record completion-list {
    items: list<completion-item>,
    /// More typing changes the answer: Codeyard asks again as the user types, instead of only filtering.
    incomplete: bool,
  }
}

/// Notices, picks, input, progress, status items and links. Every one shows the publisher.
@since(version = 1.0.0)
interface window {
  use types.{ticket, tone, error};

  @since(version = 1.0.0)
  enum severity {
    info,
    warning,
    error,
  }

  /// Completes with `chosen`: the index of the action clicked, or empty when dismissed.
  @since(version = 1.0.0)
  show-notice: func(severity: severity, message: string, actions: list<string>) -> ticket;

  @since(version = 1.0.0)
  record pick-item {
    label: string,
    detail: option<string>,
    picked: bool,
  }

  @since(version = 1.0.0)
  record pick-options {
    title: option<string>,
    placeholder: option<string>,
    many: bool,
  }

  /// Completes with `chosen`: the picked indices, or empty when dismissed.
  @since(version = 1.0.0)
  quick-pick: func(items: list<pick-item>, options: pick-options) -> ticket;

  @since(version = 1.0.0)
  record input-options {
    title: option<string>,
    prompt: option<string>,
    value: option<string>,
    placeholder: option<string>,
    password: bool,
  }

  /// Completes with `text`: what the user typed, or none when dismissed.
  @since(version = 1.0.0)
  input-box: func(options: input-options) -> ticket;

  /// Shows progress until `end-progress`. Cancelling it from the UI arrives as `request.cancel-progress`.
  @since(version = 1.0.0)
  start-progress: func(title: string, cancellable: bool) -> u64;
  @since(version = 1.0.0)
  report-progress: func(id: u64, message: option<string>, percent: option<u8>);
  @since(version = 1.0.0)
  end-progress: func(id: u64);

  @since(version = 1.0.0)
  record status-item {
    /// Local to the extension.
    id: string,
    text: string,
    tooltip: option<string>,
    /// A command id to run on click.
    command: option<string>,
    tone: tone,
  }

  @since(version = 1.0.0)
  set-status-item: func(item: status-item) -> result<_, error>;
  @since(version = 1.0.0)
  remove-status-item: func(id: string);

  /// Opens an `https:` URL in the browser. Only while handling a user action (a command or a link click): the host
  /// checks that, so the ticket completes with `done` or `failed(denied)`.
  @since(version = 1.0.0)
  open-external: func(url: string) -> ticket;
}

/// Running commands.
@since(version = 1.0.0)
interface commands {
  use types.{ticket};

  /// The extension's own command, a dependency's, or a core command (`core:…`) the manifest lists.
  /// Arguments and result are JSON; completes with `json`.
  @since(version = 1.0.0)
  execute: func(command: string, args-json: string) -> ticket;
}

/// A persisted key-value store in the extension's data folder (50 MiB in all). Answered by the exthost itself.
@since(version = 1.0.0)
interface storage {
  use types.{error};

  @since(version = 1.0.0)
  get: func(key: string) -> option<list<u8>>;
  /// Fails with `invalid` when the store would grow past its limit.
  @since(version = 1.0.0)
  set: func(key: string, value: list<u8>) -> result<_, error>;
  @since(version = 1.0.0)
  delete: func(key: string);
  @since(version = 1.0.0)
  keys: func() -> list<string>;
}

/// The extension's own settings, as declared in its manifest.
@since(version = 1.0.0)
interface settings {
  /// The value as JSON, or none when unset and without a default. Changes arrive as `request.settings-changed`.
  @since(version = 1.0.0)
  get: func(key: string) -> option<string>;
}

/// Repeating timers. An active timer keeps the exthost running.
@since(version = 1.0.0)
interface timers {
  /// Delivers `request.timer(id)` every `seconds` (at least 30), paused while the window is unfocused.
  @since(version = 1.0.0)
  every: func(seconds: u32) -> u64;
  @since(version = 1.0.0)
  clear: func(id: u64);
}

/// The extension's views.
@since(version = 1.0.0)
interface ui {
  /// Ask for the view to be drawn again: the host sends `request.render` and diffs the result by key.
  @since(version = 1.0.0)
  invalidate: func(view: string);
}

/// Open documents. A command the user started may read and edit the active document and its selections until it
/// returns; anything else needs `read` (and `write` for edits) on the document's path.
@since(version = 1.0.0)
interface documents {
  use types.{ticket, uri, range, text-edit};

  /// Completes with `document`: the active editor's document, or none.
  @since(version = 1.0.0)
  active: func() -> ticket;
  /// Completes with `ranges`: the active editor's selections.
  @since(version = 1.0.0)
  selections: func() -> ticket;
  /// Completes with `document`: an open document, or none when it is not open.
  @since(version = 1.0.0)
  read: func(uri: uri) -> ticket;
  /// Applies edits made against `version`. Completes with `done`, or `failed(invalid)` when the document changed.
  @since(version = 1.0.0)
  apply-edits: func(uri: uri, version: u32, edits: list<text-edit>) -> ticket;
  @since(version = 1.0.0)
  set-selections: func(uri: uri, selections: list<range>) -> ticket;
}

/// Diagnostics and decorations the extension shows on documents.
@since(version = 1.0.0)
interface languages {
  use types.{uri, range, diagnostic, tone};

  /// Replaces this extension's diagnostics for `uri`.
  @since(version = 1.0.0)
  set-diagnostics: func(uri: uri, diagnostics: list<diagnostic>);
  /// Removes this extension's diagnostics for `uri`, or everywhere.
  @since(version = 1.0.0)
  clear-diagnostics: func(uri: option<uri>);

  @since(version = 1.0.0)
  enum decoration-place {
    gutter,
    line,
    /// Text after the range's end, like an inline hint.
    after,
  }

  @since(version = 1.0.0)
  record decoration {
    range: range,
    place: decoration-place,
    tone: tone,
    text: option<string>,
    hover: option<string>,
  }

  /// Replaces one named set of decorations on `uri`.
  @since(version = 1.0.0)
  set-decorations: func(uri: uri, set: string, decorations: list<decoration>);
}
